   "metadata": {},
   "source": [
    "x = input(\"Please enter a number: \")\n",
    "x = int(x)\n",
    "for i in range(2, x):\n",
    "    if x % i == 0:\n",
    "        print(f\"{x} is not a prime number.\")\n",
    "        break\n",
    "else:\n",
    "    print(f\"{x} is a prime number.\")"
   ]
  }
